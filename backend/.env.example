# Category: Database -> Supabase (was MongoDB; see database/README.md).
# Production uses a Supabase PostgreSQL connection string (direct or pooled).
# Example for a Supabase project:
#   DATABASE_URL=postgresql+asyncpg://postgres:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./resume_builder.db

# Optional Supabase client credentials (used by future Supabase Auth integration).
SUPABASE_URL=
SUPABASE_KEY=

# --- OpenRouter (AI) ---
# Get a FREE key from https://openrouter.ai/keys (no credits needed for :free models)
OPENROUTER_API_KEY=your-openrouter-api-key

# Primary model. :free models cost nothing.
#   deepseek/deepseek-chat-v3-0324:free   (best for structured JSON)
#   qwen/qwen2.5-72b-instruct:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
# Find more: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Comma-separated fallback models tried automatically when the primary
# throttles / times out (e.g. 429, 5xx, or empty response).
OPENROUTER_MODEL_FALLBACKS=

# --- Render / CORS ---
# Port injected by Render; overridden by $PORT at runtime.
PORT=8000
# Extra CORS origins beyond localhost (comma-separated).
CORS_ALLOWED_ORIGINS=
# Public app URL used in OpenRouter HTTP-Referer headers.
APP_URL=http://localhost:8000